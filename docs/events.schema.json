{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.github.io/eventos/events.schema.json",
  "title": "Agenda de eventos gratuitos CABA",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "events"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "generated_at": {
      "type": "string",
      "description": "ISO-8601 con offset (-03:00)"
    },
    "city": {
      "type": "string"
    },
    "license": {
      "type": "string"
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      }
    },
    "sources": {
      "type": "array",
      "description": "Como le fue a cada fuente en la ultima corrida. Lo consume el panel de fuentes de la app.",
      "items": {
        "$ref": "#/$defs/source"
      }
    }
  },
  "$defs": {
    "event": {
      "type": "object",
      "required": [
        "id",
        "title",
        "category",
        "date",
        "access_mode",
        "venue"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "Estable entre corridas: slug(sede)+slug(titulo)+fecha"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "category": {
          "type": "string",
          "enum": [
            "MUSICA",
            "ARTES_VISUALES",
            "CINE",
            "TEATRO",
            "INFANTILES",
            "FERIAS",
            "OTROS"
          ]
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "start_time": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\d{2}:\\d{2}$"
        },
        "end_time": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\d{2}:\\d{2}$"
        },
        "all_day": {
          "type": "boolean"
        },
        "access_mode": {
          "type": "string",
          "enum": [
            "INGRESO_LIBRE",
            "ORDEN_DE_LLEGADA",
            "RESERVA_PREVIA"
          ]
        },
        "reservation_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "venue": {
          "$ref": "#/$defs/venue"
        },
        "source_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "image_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "updated_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "Quien PRODUJO el evento. Se separa de source_name porque el nombre humano se repite entre la semilla curada y las fuentes en vivo."
        }
      }
    },
    "venue": {
      "type": "object",
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "address": {
          "type": [
            "string",
            "null"
          ]
        },
        "neighborhood": {
          "type": [
            "string",
            "null"
          ]
        },
        "commune": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 15
        },
        "lat": {
          "type": [
            "number",
            "null"
          ]
        },
        "lon": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "id",
        "name",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "Coincide con source_id de los eventos."
        },
        "name": {
          "type": "string"
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "OK",
            "INCOMPLETA",
            "SIN_EVENTOS",
            "ERROR"
          ],
          "description": "OK=anda; INCOMPLETA=trae eventos pero pierde fichas que deberiamos poder leer; SIN_EVENTOS=anda pero hoy no hay nada gratis; ERROR=no responde."
        },
        "detail": {
          "type": "string",
          "description": "Una linea en castellano explicando el estado."
        },
        "events": {
          "type": "integer",
          "minimum": 0,
          "description": "Eventos publicados de esta fuente."
        },
        "items_read": {
          "type": "integer",
          "minimum": 0
        },
        "discarded": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        }
      }
    }
  }
}
